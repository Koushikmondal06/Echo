# Algorand Configuration
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_APP_ID=0

# Oracle Configuration
ORACLE_PRIVATE_KEY=base64_encoded_64_byte_ed25519_private_key
# Generate with: node -e "const nacl = require('tweetnacl'); const k = nacl.sign.keyPair(); console.log(Buffer.from(k.secretKey).toString('base64'))"

# Polymarket API URLs
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
UMA_API_URL=https://api.uma.xyz

# Secondary Source (optional)
SECONDARY_FETCHER_ENABLED=false
SECONDARY_API_URL=https://api.kalshi.com/trade-api/v2

# Scheduler Configuration
SCHEDULER_INTERVAL_MINUTES=5
SCHEDULER_LOOKAHEAD_HOURS=24

# Logging
LOG_LEVEL=info